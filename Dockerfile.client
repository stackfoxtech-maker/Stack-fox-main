# Build stage
FROM node:20-alpine AS build
WORKDIR /app
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
COPY client/package*.json ./
RUN npm install --legacy-peer-deps
COPY client/ .
# Sync master catalog data to frontend source before building
COPY shared/stackfox-data.json /app/src/data/stackfox-data.json
RUN npm run build

# Production stage
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80 443
CMD ["nginx", "-g", "daemon off;"]
