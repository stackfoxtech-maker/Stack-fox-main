# ═══════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════
DATABASE_URL="postgresql://stackfox:stackfox_dev@localhost:5432/stackfox?schema=public"
DIRECT_DATABASE_URL="postgresql://stackfox:stackfox_dev@localhost:5432/stackfox?schema=public"

# Supabase (production)
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://your-project.supabase.co"
# These names must match what the API reads (apps/api/src/lib/storage.ts).
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# ═══════════════════════════════════════
# REDIS
# ═══════════════════════════════════════
# Local dev can use a plain redis://. A hosted Redis (Upstash, Redis Cloud)
# almost always requires TLS -- use the rediss:// scheme it gives you. A plain
# redis:// URL against Upstash connects, then immediately closes, and every
# Redis-backed feature (OTP, password reset, token revocation, and ALL BullMQ
# workers) silently degrades to a no-op instead of erroring.
REDIS_URL="redis://localhost:6379"

# ═══════════════════════════════════════
# SEARCH
# ═══════════════════════════════════════
MEILI_URL="http://localhost:7700"
MEILI_MASTER_KEY="stackfox_meili_dev_key"

# ═══════════════════════════════════════
# AUTH (NextAuth.js)
# ═══════════════════════════════════════
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Default password used by `db:seed` for the seeded ADMIN account
# admin@stackfox.tech. Change this before production. If unset the seed falls
# back to "Admin@Stackfox2025".
ADMIN_PASSWORD="Admin@Stackfox2025"

# ═══════════════════════════════════════
# AI
# ═══════════════════════════════════════
GEMINI_API_KEY=""

# ═══════════════════════════════════════
# PAYMENTS
# ═══════════════════════════════════════
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# ═══════════════════════════════════════
# FILE STORAGE (Supabase Storage)
# ═══════════════════════════════════════
# File storage runs on Supabase Storage (same project as the Postgres DB).
# Create two private buckets in the Supabase dashboard -> Storage before first upload.
SUPABASE_STORAGE_BUCKET="stackfox-files"
SUPABASE_WORM_BUCKET="stackfox-worm"
# Uploads/downloads authenticate with SUPABASE_URL + SUPABASE_SECRET_KEY (declared above).

# ═══════════════════════════════════════
# WHATSAPP BSP
# ═══════════════════════════════════════
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# ═══════════════════════════════════════
# E-SIGN (Aadhaar ASP)
# ═══════════════════════════════════════
ESIGN_ASP_ID=""
ESIGN_ASP_KEY=""
ESIGN_ASP_URL=""

# ═══════════════════════════════════════
# MONITORING
# ═══════════════════════════════════════
SENTRY_DSN=""
POSTHOG_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# ═══════════════════════════════════════
# APP
# ═══════════════════════════════════════
NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Background workers (19 BullMQ queues) run inline with the API by default —
# set to "false" for day-to-day local development unless you're specifically
# testing a worker/scheduled job. Each `pnpm dev` file-save restarts the whole
# process, and each restart opens (and, once fixed, closes) 38 Redis
# connections for the queues/workers alone — on a free-tier Redis plan with a
# monthly request cap (e.g. Upstash), a long dev session with workers on can
# burn through that cap in minutes with zero real traffic. Leave unset/"true"
# in production, where the process only restarts on deploy.
WORKERS_INLINE="false"

# ═══════════════════════════════════════
# GOOGLE SIGN-IN
# ═══════════════════════════════════════
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
#
# Authorized JavaScript origins:
#   http://localhost:5173
#   https://stackfox.in
#
# Authorized redirect URIs — this is always
#   <the public origin the API answers on> + /auth/google/callback
# and it must match GOOGLE_REDIRECT_URI / API_PUBLIC_URL below character for
# character, trailing slash included. Register both:
#   http://localhost:4000/auth/google/callback
#   https://api.stackfox.in/auth/google/callback
# If production serves the API under the site domain instead of its own
# subdomain, use that path instead, e.g.
#   https://stackfox.in/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override. Defaults to ${API_PUBLIC_URL}/auth/google/callback.
GOOGLE_REDIRECT_URI=""

# ═══════════════════════════════════════
# EMAIL (Resend)
# ═══════════════════════════════════════
# Powers password-reset and email-verification links.
# Without a key those links are only logged to the server console (dev only).
RESEND_API_KEY=""
MAIL_FROM="StackFox <no-reply@stackfox.in>"

# ═══════════════════════════════════════
# PUBLIC URLS
# ═══════════════════════════════════════
# Where the browser reaches the SPA and the API. Used to build OAuth redirects
# and emailed links, which must be absolute and externally resolvable.
WEB_APP_URL="http://localhost:5173"
API_PUBLIC_URL="http://localhost:4000"

# ═══════════════════════════════════════
# CREDENTIAL VAULT
# ═══════════════════════════════════════
# 32 bytes as 64 hex chars. Encrypts client credentials (hosting, DNS, gateway
# logins) stored in CredentialVault. Required in production — the API refuses to
# start storing secrets without it. Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=""
