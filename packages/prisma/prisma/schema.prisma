  decisionNote String?   @map("decision_note")
  submittedAt  DateTime? @map("submitted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  org      Org?      @relation(fields: [orgId], references: [id])
  sdnNotes SdnNote[]

  @@index([orgId])
  @@map("rfps")
}

model SdnNote {
