FROM node:20-slim AS build
WORKDIR /repo

RUN corepack enable
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY packages/prisma/package.json packages/prisma/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json

RUN pnpm install --frozen-lockfile

COPY packages/prisma packages/prisma
COPY packages/core packages/core
COPY packages/tsconfig packages/tsconfig
# The cart prices against the shared catalogue, so it must ship with the API.
COPY shared shared
COPY apps/api apps/api

RUN pnpm --filter @stackfox/prisma exec prisma generate
RUN pnpm --filter @stackfox/prisma build
RUN pnpm --filter @stackfox/core build
# `tsc` gates the image — the API type-checks clean, so a real type error must
# fail the build rather than ship. (The old worker type errors are fixed.)
RUN pnpm --filter @stackfox/api build && test -f apps/api/dist/server.js

FROM node:20-slim AS runtime
WORKDIR /repo
RUN corepack enable
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/apps/api ./apps/api
COPY --from=build /repo/packages ./packages
COPY --from=build /repo/shared ./shared
COPY --from=build /repo/package.json ./package.json

ENV NODE_ENV=production
EXPOSE 4000

# Apply any pending migrations (advisory-locked, safe with one instance), then
# start the server. `migrate deploy` never generates or resets — it only runs
# committed migration files.
WORKDIR /repo
CMD sh -c "pnpm --filter @stackfox/prisma exec prisma migrate deploy && cd apps/api && node dist/server.js"
